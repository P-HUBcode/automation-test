                  "pm.test(\"Verify programmatically defined variables\", function () {",
                  "    pm.expect(pm.globals.get(\"dynamic_global_user\")).to.eql(\"NguyenMinhPhu_Global\");",
                  "    pm.expect(pm.collectionVariables.get(\"dynamic_col_title\")).to.eql(\"PLT Solutions Automation\");",
                  "    pm.expect(pm.environment.get(\"dynamic_env_body\")).to.eql(\"API Testing with Postman\");",
                  "});",
